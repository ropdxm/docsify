# Supabase - copy to .env.local and fill in from your project's API settings.
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key - SERVER ONLY. Never expose to the browser / never prefix NEXT_PUBLIC.
# Used to provision a company at signup and to read/store PDFs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Required by Vercel because the bundled LibreOffice WASM runtime exceeds the
# standard function size. Enable Fluid Compute and set this for deployments.
VERCEL_SUPPORT_LARGE_FUNCTIONS=1

# Goszakupki import - SERVER ONLY. Used to prefill invoice/AVR drafts from contracts.
GOSZAKUPKI_API_TOKEN=your-goszakupki-token

# Kaspi POS Automation - billing for the Pro plan. SERVER ONLY.
# Run/deploy https://github.com/tapter-dev/kaspi-pos-automation separately.
# Base URL is the service root, not Docsify's URL.
KASPI_POS_BASE_URL=https://your-kaspi-pos-service.example.com
KASPI_POS_TOKEN_SN=
KASPI_POS_VTOKEN_SECRET=
# Optional when the Kaspi auth flow returns a profile id.
KASPI_POS_PROFILE_ID=
# Must match the `secret` in that service's webhooks.json.
# Webhook URL for that service: <your-domain>/api/kaspi-pos/webhook
KASPI_POS_WEBHOOK_SECRET=
