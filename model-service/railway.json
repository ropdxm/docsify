{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 600,
    "restartPolicyType": "ALWAYS",
    "sleepApplication": false,
    "drainingSeconds": 30
  }
}
